generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id            String     @id @default(cuid())
  userId        String
  name          String
  sourceType    String
  sourceUrl     String?
  filePath      String?
  thumbnailPath String?
  createdAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses      Analysis[]

  @@index([userId])
}

model Analysis {
  id           String    @id @default(cuid())
  projectId    String
  status       String    @default("pending")
  overallScore Int?
  scores       String?
  report       String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues       Issue[]

  @@index([projectId])
}

model Issue {
  id             String   @id @default(cuid())
  analysisId     String
  category       String
  severity       String
  title          String
  description    String
  recommendation String
  x              Float?
  y              Float?
  width          Float?
  height         Float?
  analysis       Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}
